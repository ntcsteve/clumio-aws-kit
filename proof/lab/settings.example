# The proof lab's settings. Copy this file to terraform.tfvars in this folder, then set the values.
# A TEST account only: the lab creates billable resources (about $5 a day with every part).

account_id = "ACCOUNT-ID-REPLACE-THIS" # the test account connected in 1-connect/
region     = "REGION-REPLACE-THIS"     # the Region connected in 1-connect/
profile    = "PROFILE-REPLACE-THIS"    # the name set in the 2-protect- folders, such as "gold"
parts      = ["s3", "rds-amk", "aurora-amk", "aurora-cmk", "bad-tag", "ec2-amk", "ec2-cmk", "ebs-amk", "ebs-cmk", "ebs-double"]
