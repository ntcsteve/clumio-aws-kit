# Your settings: copied from settings.example, never committed
terraform.tfvars

# Terraform state, plans and working files. Keep state private: it maps your account's Clumio setup.
*.tfstate
*.tfstate.*
tfplan
*.tfplan
.terraform/
crash.log
tf-debug.log

# Credentials
.env
*.pem

# Preview output: one folder per run, for your security team, not for git
clumio-iam-preview-*/

# Saved status (3-prove): it names your AWS account
status-*.json

__pycache__/
.DS_Store

# Modules are called by others, who lock their own providers
modules/**/.terraform.lock.hcl
