{
  "Statement": [
    {
      "Action": "rds:CopyDBClusterSnapshot",
      "Effect": "Allow",
      "Resource": [
        "arn:aws:rds:*:<ACCOUNT_ID>:cluster-snapshot:*",
        "arn:aws:rds:*:<CLUMIO_DATA_PLANE_ACCOUNT_ID>:cluster-snapshot:*"
      ],
      "Sid": "CopyClusterSnapshotFromClumio"
    },
    {
      "Action": "rds:CopyDBSnapshot",
      "Effect": "Allow",
      "Resource": [
        "arn:aws:rds:*:<ACCOUNT_ID>:snapshot:*",
        "arn:aws:rds:*:<ACCOUNT_ID>:og:*",
        "arn:aws:rds:*:<CLUMIO_DATA_PLANE_ACCOUNT_ID>:snapshot:*",
        "arn:aws:rds:*:<CLUMIO_DATA_PLANE_ACCOUNT_ID>:og:*"
      ],
      "Sid": "CopyInstanceSnapshotFromClumio"
    },
    {
      "Action": "rds:DescribeDBSubnetGroups",
      "Effect": "Allow",
      "Resource": "arn:aws:rds:ap-southeast-2:<ACCOUNT_ID>:subgrp:*",
      "Sid": "VerifyingSubnetGroups"
    },
    {
      "Action": "rds:DeleteDBClusterSnapshot",
      "Condition": {
        "StringLike": {
          "rds:cluster-snapshot-tag/clumio.rds.snapshot.tag": "*"
        }
      },
      "Effect": "Allow",
      "Resource": "*",
      "Sid": "ClusterSnapshotCleanupPermissions"
    },
    {
      "Action": "rds:DeleteDBSnapshot",
      "Condition": {
        "StringLike": {
          "rds:snapshot-tag/clumio.rds.snapshot.tag": "*"
        }
      },
      "Effect": "Allow",
      "Resource": "*",
      "Sid": "InstanceSnapshotCleanupPermissions"
    },
    {
      "Action": "rds:ListTagsForResource",
      "Effect": "Allow",
      "Resource": [
        "arn:aws:rds:ap-southeast-2:<ACCOUNT_ID>:db:*",
        "arn:aws:rds:ap-southeast-2:<ACCOUNT_ID>:cluster:*",
        "arn:aws:rds:*:<ACCOUNT_ID>:snapshot:*",
        "arn:aws:rds:*:<ACCOUNT_ID>:cluster-snapshot:*"
      ],
      "Sid": "ListClumioTagsForRestoredTag"
    },
    {
      "Action": "rds:CreateDBInstance",
      "Effect": "Allow",
      "Resource": [
        "arn:aws:rds:ap-southeast-2:<ACCOUNT_ID>:subgrp:*",
        "arn:aws:rds:ap-southeast-2:<ACCOUNT_ID>:secgrp:*",
        "arn:aws:rds:ap-southeast-2:<ACCOUNT_ID>:pg:*",
        "arn:aws:rds:ap-southeast-2:<ACCOUNT_ID>:og:*",
        "arn:aws:rds:ap-southeast-2:<ACCOUNT_ID>:db:*",
        "arn:aws:rds:ap-southeast-2:<ACCOUNT_ID>:cluster:*"
      ],
      "Sid": "RestoreInstancesInACluster"
    },
    {
      "Action": [
        "rds:DescribeDBParameterGroups",
        "rds:DescribeDBClusterParameterGroups",
        "rds:CreateDBParameterGroup",
        "rds:CreateDBClusterParameterGroup"
      ],
      "Effect": "Allow",
      "Resource": [
        "arn:aws:rds:*:<ACCOUNT_ID>:pg:*",
        "arn:aws:rds:*:<ACCOUNT_ID>:cluster-pg:*"
      ],
      "Sid": "RestoreParameterGroups"
    },
    {
      "Action": "rds:RestoreDBInstanceFromDBSnapshot",
      "Effect": "Allow",
      "Resource": [
        "arn:aws:rds:ap-southeast-2:<ACCOUNT_ID>:subgrp:*",
        "arn:aws:rds:ap-southeast-2:<ACCOUNT_ID>:snapshot:*",
        "arn:aws:rds:ap-southeast-2:<ACCOUNT_ID>:pg:*",
        "arn:aws:rds:ap-southeast-2:<ACCOUNT_ID>:og:*",
        "arn:aws:rds:ap-southeast-2:<ACCOUNT_ID>:db:*"
      ],
      "Sid": "RestoreInstanceFromSnapshot"
    },
    {
      "Action": "rds:RestoreDBInstanceToPointInTime",
      "Effect": "Allow",
      "Resource": [
        "arn:aws:rds:ap-southeast-2:<ACCOUNT_ID>:subgrp:*",
        "arn:aws:rds:ap-southeast-2:<ACCOUNT_ID>:pg:*",
        "arn:aws:rds:ap-southeast-2:<ACCOUNT_ID>:og:*",
        "arn:aws:rds:ap-southeast-2:<ACCOUNT_ID>:db:*",
        "arn:aws:rds:ap-southeast-2:<ACCOUNT_ID>:auto-backup:*"
      ],
      "Sid": "RestoreInstanceToPointInTime"
    },
    {
      "Action": "rds:RestoreDBClusterFromSnapshot",
      "Effect": "Allow",
      "Resource": [
        "arn:aws:rds:ap-southeast-2:<ACCOUNT_ID>:subgrp:*",
        "arn:aws:rds:ap-southeast-2:<ACCOUNT_ID>:og:*",
        "arn:aws:rds:ap-southeast-2:<ACCOUNT_ID>:cluster:*",
        "arn:aws:rds:ap-southeast-2:<ACCOUNT_ID>:cluster-snapshot:*",
        "arn:aws:rds:ap-southeast-2:<ACCOUNT_ID>:cluster-pg:*"
      ],
      "Sid": "RestoreClusterFromSnapshot"
    },
    {
      "Action": "rds:RestoreDBClusterToPointInTime",
      "Effect": "Allow",
      "Resource": [
        "arn:aws:rds:ap-southeast-2:<ACCOUNT_ID>:subgrp:*",
        "arn:aws:rds:ap-southeast-2:<ACCOUNT_ID>:og:*",
        "arn:aws:rds:ap-southeast-2:<ACCOUNT_ID>:cluster:*",
        "arn:aws:rds:ap-southeast-2:<ACCOUNT_ID>:cluster-pg:*",
        "arn:aws:rds:ap-southeast-2:<ACCOUNT_ID>:auto-backup:*"
      ],
      "Sid": "RestoreClusterToPointInTime"
    },
    {
      "Action": "rds:RemoveTagsFromResource",
      "Effect": "Allow",
      "Resource": [
        "arn:aws:rds:ap-southeast-2:<ACCOUNT_ID>:db:*",
        "arn:aws:rds:ap-southeast-2:<ACCOUNT_ID>:db-snapshot:*",
        "arn:aws:rds:ap-southeast-2:<ACCOUNT_ID>:cluster:*",
        "arn:aws:rds:ap-southeast-2:<ACCOUNT_ID>:cluster-snapshot:*"
      ],
      "Sid": "RemoveClumioTagAfterRestore"
    },
    {
      "Action": "rds:AddTagsToResource",
      "Effect": "Allow",
      "Resource": [
        "arn:aws:rds:ap-southeast-2:<ACCOUNT_ID>:db:*",
        "arn:aws:rds:ap-southeast-2:<ACCOUNT_ID>:cluster:*",
        "arn:aws:rds:*:<ACCOUNT_ID>:snapshot:*",
        "arn:aws:rds:*:<ACCOUNT_ID>:og:*",
        "arn:aws:rds:*:<ACCOUNT_ID>:cluster-snapshot:*"
      ],
      "Sid": "AddingClumioTagToRestoredRDSResource"
    },
    {
      "Action": "rds:CreateOptionGroup",
      "Effect": "Allow",
      "Resource": "arn:aws:rds:*:<ACCOUNT_ID>:og:*",
      "Sid": "RestoreOptionGroups"
    },
    {
      "Action": "rds:CreateDBInstanceReadReplica",
      "Effect": "Allow",
      "Resource": [
        "arn:aws:rds:*:<ACCOUNT_ID>:subgrp:*",
        "arn:aws:rds:*:<ACCOUNT_ID>:secgrp:*",
        "arn:aws:rds:*:<ACCOUNT_ID>:pg:*",
        "arn:aws:rds:*:<ACCOUNT_ID>:og:*",
        "arn:aws:rds:*:<ACCOUNT_ID>:db:*",
        "arn:aws:rds:*:<ACCOUNT_ID>:cluster:*",
        "arn:aws:rds:*:<ACCOUNT_ID>:cluster-pg:*"
      ],
      "Sid": "RestoreReadReplicas"
    },
    {
      "Action": "rds:DeleteDBCluster",
      "Condition": {
        "StringLike": {
          "rds:cluster-tag/clumio.restore.tag": "*"
        }
      },
      "Effect": "Allow",
      "Resource": "arn:aws:rds:ap-southeast-2:<ACCOUNT_ID>:cluster:*",
      "Sid": "ClusterCleanupPermissions"
    },
    {
      "Action": "rds:DeleteDBInstance",
      "Condition": {
        "StringLike": {
          "rds:db-tag/clumio.restore.tag": "*"
        }
      },
      "Effect": "Allow",
      "Resource": "arn:aws:rds:ap-southeast-2:<ACCOUNT_ID>:db:*",
      "Sid": "InstanceCleanupPermissions"
    },
    {
      "Action": "rds:AddRoleToDBCluster",
      "Effect": "Allow",
      "Resource": "arn:aws:rds:ap-southeast-2:<ACCOUNT_ID>:cluster:*",
      "Sid": "RestoreAssociatedRolesInCluster"
    },
    {
      "Action": "rds:AddRoleToDBInstance",
      "Effect": "Allow",
      "Resource": "arn:aws:rds:ap-southeast-2:<ACCOUNT_ID>:db:*",
      "Sid": "RestoreAssociatedRolesInInstance"
    },
    {
      "Action": "iam:PassRole",
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": "rds.amazonaws.com"
        }
      },
      "Effect": "Allow",
      "Resource": "arn:aws:iam::<ACCOUNT_ID>:role/*",
      "Sid": "PassAssociatedRoles"
    },
    {
      "Action": "kms:CreateGrant",
      "Effect": "Allow",
      "Resource": "arn:aws:kms:*:*:key/*",
      "Sid": "RestoreKMSPermissions"
    }
  ],
  "Version": "2012-10-17"
}