{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Action": "backup:ListProtectedResources",
      "Effect": "Allow",
      "Resource": "*",
      "Sid": "GetBackedUpResources"
    },
    {
      "Action": "backup:ListBackupVaults",
      "Effect": "Allow",
      "Resource": "*",
      "Sid": "GetAWSBackupVaults"
    },
    {
      "Action": "backup:ListRecoveryPointsByBackupVault",
      "Effect": "Allow",
      "Resource": "arn:aws:backup:ap-southeast-2:<ACCOUNT_ID>:backup-vault:*",
      "Sid": "GetAWSRecoveryPoints"
    },
    {
      "Action": "backup:DescribeRecoveryPoint",
      "Effect": "Allow",
      "Resource": "*",
      "Sid": "GetAWSRecoveryPointInfo"
    },
    {
      "Action": [
        "ec2:DescribeTags",
        "ec2:DescribeSnapshots",
        "ec2:DescribeSecurityGroups",
        "ec2:DescribeInstances",
        "ec2:DescribeInstanceTypes",
        "ec2:DescribeInstanceTypeOfferings",
        "ec2:DescribeInstanceStatus",
        "ec2:DescribeInstanceCreditSpecifications",
        "ec2:DescribeInstanceAttribute",
        "ec2:DescribeImages",
        "ec2:DescribeImageAttribute",
        "ec2:DescribeAvailabilityZones"
      ],
      "Effect": "Allow",
      "Resource": "*",
      "Sid": "DescribeEc2Resources"
    },
    {
      "Action": [
        "kms:DescribeKey",
        "ec2:DescribeVolumes",
        "ec2:DescribeVolumeStatus",
        "ec2:DescribeVolumeAttribute",
        "ec2:DescribeSnapshots",
        "ec2:DescribeSnapshotAttribute",
        "ec2:DescribeLockedSnapshots",
        "ec2:DescribeFastSnapshotRestores",
        "ebs:ListSnapshotBlocks",
        "ebs:ListChangedBlocks"
      ],
      "Effect": "Allow",
      "Resource": "*",
      "Sid": "DescribeEbsResources"
    },
    {
      "Action": [
        "rbin:ListRules",
        "rbin:GetRule"
      ],
      "Effect": "Allow",
      "Resource": "arn:aws:rbin:ap-southeast-2:<ACCOUNT_ID>:rule/*",
      "Sid": "DescribeRBinResources"
    },
    {
      "Action": "rds:DescribeDBClusters",
      "Effect": "Allow",
      "Resource": "arn:aws:rds:ap-southeast-2:<ACCOUNT_ID>:cluster:*",
      "Sid": "DescribeRDSClusters"
    },
    {
      "Action": [
        "rds:DescribeDBClusterSnapshots",
        "rds:DescribeDBClusterSnapshotAttributes"
      ],
      "Effect": "Allow",
      "Resource": [
        "arn:aws:rds:*:<ACCOUNT_ID>:cluster-snapshot:*",
        "arn:aws:rds:*:<CLUMIO_DATA_PLANE_ACCOUNT_ID>:cluster-snapshot:*"
      ],
      "Sid": "DescribeRDSClusterSnapshots"
    },
    {
      "Action": "rds:DescribeDBInstances",
      "Effect": "Allow",
      "Resource": "arn:aws:rds:ap-southeast-2:<ACCOUNT_ID>:db:*",
      "Sid": "DescribeRDSInstances"
    },
    {
      "Action": "rds:DescribeDBInstanceAutomatedBackups",
      "Effect": "Allow",
      "Resource": [
        "arn:aws:rds:ap-southeast-2:<ACCOUNT_ID>:db:*",
        "arn:aws:rds:ap-southeast-2:<ACCOUNT_ID>:auto-backup:*"
      ],
      "Sid": "DescribeRDSAutomatedBackups"
    },
    {
      "Action": "rds:DescribeDBSnapshotAttributes",
      "Effect": "Allow",
      "Resource": [
        "arn:aws:rds:*:<ACCOUNT_ID>:snapshot:*",
        "arn:aws:rds:*:<CLUMIO_DATA_PLANE_ACCOUNT_ID>:snapshot:*"
      ],
      "Sid": "DescribeRDSInstanceSnapshotAttributes"
    },
    {
      "Action": "rds:DescribeDBSnapshots",
      "Effect": "Allow",
      "Resource": [
        "arn:aws:rds:*:<ACCOUNT_ID>:snapshot:*",
        "arn:aws:rds:*:<ACCOUNT_ID>:db:*",
        "arn:aws:rds:*:<CLUMIO_DATA_PLANE_ACCOUNT_ID>:snapshot:*",
        "arn:aws:rds:*:<CLUMIO_DATA_PLANE_ACCOUNT_ID>:db:*"
      ],
      "Sid": "DescribeRDSInstanceSnapshots"
    },
    {
      "Action": "rds:DescribeGlobalClusters",
      "Effect": "Allow",
      "Resource": "arn:aws:rds:ap-southeast-2:<ACCOUNT_ID>:global-cluster:*",
      "Sid": "DescribeRDSGlobalClusters"
    },
    {
      "Action": [
        "rds:DescribeOptionGroups",
        "rds:DescribeOptionGroupOptions"
      ],
      "Effect": "Allow",
      "Resource": "arn:aws:rds:*:<ACCOUNT_ID>:og:*",
      "Sid": "DescribeRDSOptionGroups"
    },
    {
      "Action": "rds:ListTagsForResource",
      "Effect": "Allow",
      "Resource": [
        "arn:aws:rds:ap-southeast-2:<ACCOUNT_ID>:db:*",
        "arn:aws:rds:ap-southeast-2:<ACCOUNT_ID>:cluster:*"
      ],
      "Sid": "ListingRDSTags"
    },
    {
      "Action": "cloudwatch:GetMetricStatistics",
      "Effect": "Allow",
      "Resource": "*",
      "Sid": "CloudWatchMetricReadPermissions"
    },
    {
      "Action": [
        "s3:ListAllMyBuckets",
        "s3:GetReplicationConfiguration",
        "s3:GetMetricsConfiguration",
        "s3:GetLifecycleConfiguration",
        "s3:GetEncryptionConfiguration",
        "s3:GetBucketVersioning",
        "s3:GetBucketTagging",
        "s3:GetBucketPublicAccessBlock",
        "s3:GetBucketPolicy",
        "s3:GetBucketObjectLockConfiguration",
        "s3:GetBucketLogging",
        "s3:GetBucketLocation",
        "backup:ListProtectedResources"
      ],
      "Condition": {
        "StringEquals": {
          "s3:ResourceAccount": "<ACCOUNT_ID>"
        }
      },
      "Effect": "Allow",
      "Resource": "arn:aws:s3:::*",
      "Sid": "DescribeS3Resources"
    },
    {
      "Action": "s3:GetMultiRegionAccessPoint",
      "Condition": {
        "StringEquals": {
          "s3:ResourceAccount": "<ACCOUNT_ID>"
        }
      },
      "Effect": "Allow",
      "Resource": "arn:aws:s3::<ACCOUNT_ID>:accesspoint/*",
      "Sid": "GetMultiRegionAccessPoint"
    },
    {
      "Action": "s3:ListMultiRegionAccessPoints",
      "Condition": {
        "StringEquals": {
          "s3:ResourceAccount": "<ACCOUNT_ID>"
        }
      },
      "Effect": "Allow",
      "Resource": "*",
      "Sid": "ListMultiRegionAccessPoints"
    },
    {
      "Action": [
        "s3:PutStorageLensConfigurationTagging",
        "s3:PutStorageLensConfiguration",
        "s3:ListStorageLensConfigurations",
        "s3:GetStorageLensConfigurationTagging",
        "s3:GetStorageLensConfiguration",
        "s3:DeleteStorageLensConfiguration"
      ],
      "Condition": {
        "StringEquals": {
          "s3:ResourceAccount": "<ACCOUNT_ID>"
        }
      },
      "Effect": "Allow",
      "Resource": "arn:aws:s3:*:<ACCOUNT_ID>:storage-lens/clumio-storage-lens-*",
      "Sid": "StorageLens"
    },
    {
      "Action": "cloudwatch:GetMetricStatistics",
      "Effect": "Allow",
      "Resource": "*",
      "Sid": "GetS3CloudwatchMetrics"
    }
  ]
}