# Settings for 2-protect-s3. Copy this file to terraform.tfvars in this folder, then check the values:
#   cp settings.example terraform.tfvars
# Keep each value on one line. terraform.tfvars never leaves your machine.
# The account, Region, unit and mode come from 1-connect: apply it first.

name             = "gold" # the profile: resources tagged clumio-profile = gold get this protection
keep_days        = 30     # how long each daily SecureVault copy is kept, in days; 30 or more for S3
backtrack_months = 3      # how far back Backtrack can roll a bucket, in months
