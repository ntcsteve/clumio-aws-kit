# Your settings. Copy this file to terraform.tfvars in this folder, then set the first four values:
#   cp settings.example terraform.tfvars
# make preflight, make preview and make plan all read terraform.tfvars, so what you check is what
# you create. Keep each value on one line, as below. terraform.tfvars never leaves your machine.

account_id          = "ACCOUNT-ID-REPLACE-THIS" # your 12-digit AWS account ID; the plan stops if you're signed in to another
region              = "REGION-REPLACE-THIS"     # where your data is, such as us-west-2
organizational_unit = "UNIT-REPLACE-THIS"       # "global", or a unit's ID: make preflight lists them
mode                = "MODE-REPLACE-THIS"       # "trial" (can be torn down, also for a proof of concept) or "production" (refuses destroy)

# Protection profiles. Tag a resource clumio-profile = <name> and that profile protects it.
# make plan shows each tagged database's PITR window now, and after: Clumio sets it, up or down.
profiles = {
  gold = {
    s3                  = true # S3 buckets: Backtrack, and a daily SecureVault copy
    databases           = true # RDS and Aurora: AWS PITR, a daily SecureVault copy, a monthly archive
    keep_days           = 30   # daily SecureVault copies, in days; 30 or more when s3 is on
    archive_months      = 12   # monthly database archive, in months; 0 turns it off; under 12 costs an early-deletion fee
    backtrack_months    = 3    # how far back Backtrack can roll a bucket, in months
    pitr_retention_days = null # REPLACE: 1 to 35 days. Clumio sets it on every gold database, longer or shorter than today
    # rule_before_id    = "<rule ID>" # only when make status says another rule claimed these databases first
  }
}

# Who gets Clumio's daily compliance report for this Region (not yet proven live):
# report_emails = ["platform-oncall@example.com"]

# Your organization's IAM rules. make preview shows every role and policy these produce.
iam_prefix = ""         # such as "platform-clumio", if IAM names must start with a prefix
iam_path   = "/clumio/" # "/" if your naming rule allows no path

# Only if your organization requires them:
# role_tags                = { team = "platform" }
# permissions_boundary_arn = "arn:aws:iam::123456789012:policy/<boundary>"
# pass_role_deny_list      = ["arn:aws:iam::123456789012:role/<role Clumio must never pass>"]
